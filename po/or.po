msgid "Mini-icon size"
msgstr "ଛୋଟ ଆଇକନ୍‌ର ଆକାର"

msgid "Unfold from edge"
msgstr "ଧାରରୁ ଖୋଲିବା"

msgid "Sheet"
msgstr "ପୃଷ୍ଠା (Sheet)"

msgid "Icon rotation"
msgstr "ଆଇକନ୍ ଘୂର୍ଣ୍ଣନ"

msgid "Always use card stack"
msgstr "ସର୍ବଦା କାର୍ଡ ଥାକ ବ୍ୟବହାର କରନ୍ତୁ"


msgid "Fade"
msgstr "ଧୀରେ ଦେଖାଯିବା"

