#, python-format
msgid "%s, percent"
msgstr "%s, ପ୍ରତିଶତ"

msgid "All files"
msgstr "ସମସ୍ତ ଫାଇଲ୍"

msgid "All images — PNG, JPEG, BMP, WebP, GIF, SVG"
msgstr "ସମସ୍ତ ଛବି — PNG, JPEG, BMP, WebP, GIF, SVG"

msgid "Appearance and animation"
msgstr "ଦୃଶ୍ୟ ଓ ଆନିମେସନ୍"

msgid "Application folders, appearance, and animation"
msgstr "ଆପ୍ ଫୋଲ୍ଡର୍, ଦୃଶ୍ୟ ଓ ଆନିମେସନ୍"

msgid "Application launcher not found."
msgstr "ଆପ୍ ଲଞ୍ଚର୍ ମିଳିଲା ନାହିଁ।"

msgid "Applications in a folder share one icon and a running indicator"
msgstr "ଫୋଲ୍ଡର୍‌ର ଆପ୍‌ଗୁଡ଼ିକ ଗୋଟିଏ ଆଇକନ୍ ଓ ଚାଲୁଥିବା ସୂଚକ ବ୍ୟବହାର କରନ୍ତି"

msgid "Background color"
msgstr "ପୃଷ୍ଠଭୂମି ରଙ୍ଗ"

msgid "Blurs the desktop and windows behind a folder and adds a translucent tint. Icons stay sharp. May increase GPU usage."
msgstr "ଫୋଲ୍ଡର୍ ପଛର ଡେସ୍କଟପ୍ ଓ ୱିଣ୍ଡୋକୁ ଝାପସା କରି ଅର୍ଦ୍ଧସ୍ୱଚ୍ଛ ରଙ୍ଗ ଯୋଡ଼େ। ଆଇକନ୍ ସ୍ପଷ୍ଟ ରହେ। GPU ବ୍ୟବହାର ବଢ଼ିପାରେ।"

msgid "Change names, labels, colors, and wallpaper using the gear inside a folder"
msgstr "ଫୋଲ୍ଡର୍ ଭିତରର ଗିଅର୍ ଦ୍ୱାରା ନାମ, ଲେବଲ୍, ରଙ୍ଗ ଓ ୱାଲପେପର୍ ବଦଳାନ୍ତୁ"

msgid "Changes are saved automatically"
msgstr "ପରିବର୍ତ୍ତନ ସ୍ୱୟଂଚାଳିତ ଭାବେ ସଞ୍ଚୟ ହୁଏ"

msgid "Choose an application"
msgstr "ଆପ୍ ବାଛନ୍ତୁ"

msgid "Choose…"
msgstr "ବାଛନ୍ତୁ…"

msgid "Close"
msgstr "ବନ୍ଦ କରନ୍ତୁ"

msgid "Could not launch the application."
msgstr "ଆପ୍ ଆରମ୍ଭ କରିହେଲା ନାହିଁ।"

msgid "Could not open system settings"
msgstr "ସିଷ୍ଟମ୍ ସେଟିଂସ୍ ଖୋଲିହେଲା ନାହିଁ"

msgid "Could not open the application"
msgstr "ଆପ୍ ଖୋଲିହେଲା ନାହିଁ"

