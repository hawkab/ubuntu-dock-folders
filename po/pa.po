#, python-format
msgid "%s, percent"
msgstr "%s, ਪ੍ਰਤੀਸ਼ਤ"

msgid "All files"
msgstr "ਸਾਰੀਆਂ ਫ਼ਾਈਲਾਂ"

msgid "All images — PNG, JPEG, BMP, WebP, GIF, SVG"
msgstr "ਸਾਰੇ ਚਿੱਤਰ — PNG, JPEG, BMP, WebP, GIF, SVG"

msgid "Appearance and animation"
msgstr "ਦਿੱਖ ਅਤੇ ਐਨੀਮੇਸ਼ਨ"

msgid "Application folders, appearance, and animation"
msgstr "ਐਪ ਫੋਲਡਰ, ਦਿੱਖ ਅਤੇ ਐਨੀਮੇਸ਼ਨ"

msgid "Application launcher not found."
msgstr "ਐਪ ਦਾ ਲਾਂਚਰ ਨਹੀਂ ਮਿਲਿਆ।"

msgid "Applications in a folder share one icon and a running indicator"
msgstr "ਫੋਲਡਰ ਦੀਆਂ ਐਪਾਂ ਇੱਕੋ ਆਈਕਨ ਅਤੇ ਚੱਲਣ ਦਾ ਸੰਕੇਤ ਸਾਂਝਾ ਕਰਦੀਆਂ ਹਨ"

msgid "Background color"
msgstr "ਪਿਛੋਕੜ ਦਾ ਰੰਗ"

msgid "Blurs the desktop and windows behind a folder and adds a translucent tint. Icons stay sharp. May increase GPU usage."
msgstr "ਫੋਲਡਰ ਪਿੱਛੇ ਡੈਸਕਟਾਪ ਅਤੇ ਵਿੰਡੋ ਨੂੰ ਧੁੰਦਲਾ ਕਰਕੇ ਅਰਧਪਾਰਦਰਸ਼ੀ ਰੰਗ ਜੋੜਦਾ ਹੈ। ਆਈਕਨ ਸਾਫ਼ ਰਹਿੰਦੇ ਹਨ। GPU ਦੀ ਵਰਤੋਂ ਵਧ ਸਕਦੀ ਹੈ।"

msgid "Change names, labels, colors, and wallpaper using the gear inside a folder"
msgstr "ਫੋਲਡਰ ਅੰਦਰ ਗੀਅਰ ਨਾਲ ਨਾਂ, ਲੇਬਲ, ਰੰਗ ਅਤੇ ਵਾਲਪੇਪਰ ਬਦਲੋ"

msgid "Changes are saved automatically"
msgstr "ਤਬਦੀਲੀਆਂ ਆਪਣੇ ਆਪ ਸੰਭਾਲੀਆਂ ਜਾਂਦੀਆਂ ਹਨ"

msgid "Choose an application"
msgstr "ਐਪ ਚੁਣੋ"

msgid "Choose…"
msgstr "ਚੁਣੋ…"

msgid "Close"
msgstr "ਬੰਦ ਕਰੋ"

msgid "Could not launch the application."
msgstr "ਐਪ ਸ਼ੁਰੂ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕੀ।"

msgid "Could not open system settings"
msgstr "ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਨਹੀਂ ਖੋਲ੍ਹੀਆਂ ਜਾ ਸਕੀਆਂ"

msgid "Could not open the application"
msgstr "ਐਪ ਨਹੀਂ ਖੋਲ੍ਹੀ ਜਾ ਸਕੀ"

msgid "Could not open the image"
msgstr "ਚਿੱਤਰ ਨਹੀਂ ਖੋਲ੍ਹਿਆ ਜਾ ਸਕਿਆ"

msgid "Customize each folder"
msgstr "ਹਰੇਕ ਫੋਲਡਰ ਨੂੰ ਅਨੁਕੂਲ ਬਣਾਓ"

msgid "Dock folders"
msgstr "ਡੌਕ ਫੋਲਡਰ"

msgid "Dock icon background color"
msgstr "ਡੌਕ ਆਈਕਨ ਦੇ ਪਿਛੋਕੜ ਦਾ ਰੰਗ"

msgid "Dock icon preview"
msgstr "ਡੌਕ ਆਈਕਨ ਦੀ ਝਲਕ"

msgid "Dock icon transparency"
msgstr "ਡੌਕ ਆਈਕਨ ਦੀ ਪਾਰਦਰਸ਼ਤਾ"

msgid "Drag an icon onto another to create a folder. Reorder applications inside a folder, or drag them out to move them back to the dock."
msgstr "ਫੋਲਡਰ ਬਣਾਉਣ ਲਈ ਇੱਕ ਆਈਕਨ ਨੂੰ ਦੂਜੇ ਉੱਤੇ ਖਿੱਚੋ। ਫੋਲਡਰ ਵਿੱਚ ਐਪਾਂ ਦਾ ਕ੍ਰਮ ਬਦਲੋ ਜਾਂ ਉਹਨਾਂ ਨੂੰ ਬਾਹਰ ਖਿੱਚ ਕੇ ਡੌਕ ਉੱਤੇ ਵਾਪਸ ਲਿਆਓ।"

msgid "Folder appearance"
msgstr "ਫੋਲਡਰ ਦੀ ਦਿੱਖ"

msgid "Folder label size"
msgstr "ਫੋਲਡਰ ਲੇਬਲ ਦਾ ਆਕਾਰ"

msgid "Folder not found."
msgstr "ਫੋਲਡਰ ਨਹੀਂ ਮਿਲਿਆ।"

msgid "Folder settings"
msgstr "ਫੋਲਡਰ ਸੈਟਿੰਗਾਂ"

msgid "Folder wallpaper"
msgstr "ਫੋਲਡਰ ਦਾ ਵਾਲਪੇਪਰ"

msgid "Folders on the dock"
msgstr "ਡੌਕ ਉੱਤੇ ਫੋਲਡਰ"

msgid "Font size below dock icons, in pixels"
msgstr "ਡੌਕ ਆਈਕਨਾਂ ਹੇਠਾਂ ਫੌਂਟ ਦਾ ਆਕਾਰ, ਪਿਕਸਲਾਂ ਵਿੱਚ"

msgid "General folder settings"
msgstr "ਫੋਲਡਰ ਦੀਆਂ ਆਮ ਸੈਟਿੰਗਾਂ"

msgid "Genie effect"
msgstr "ਜਿੰਨ ਪ੍ਰਭਾਵ"

msgid "Glass tint transparency"
msgstr "ਕੱਚ ਦੇ ਰੰਗ ਦੀ ਪਾਰਦਰਸ਼ਤਾ"

msgid "Icon preview"
msgstr "ਆਈਕਨ ਦੀ ਝਲਕ"

msgid "Image selected"
msgstr "ਚਿੱਤਰ ਚੁਣਿਆ ਗਿਆ"

msgid "Label below the icon"
msgstr "ਆਈਕਨ ਹੇਠਾਂ ਲੇਬਲ"

msgid "Material Glass — frosted glass"
msgstr "Material Glass — ਧੁੰਦਲਾ ਕੱਚ"

msgid "Material Glass: blurred background, translucent tint, and sharp icons."
msgstr "Material Glass: ਧੁੰਦਲਾ ਪਿਛੋਕੜ, ਅਰਧਪਾਰਦਰਸ਼ੀ ਰੰਗ ਅਤੇ ਸਾਫ਼ ਆਈਕਨ।"

msgid "Name"
msgstr "ਨਾਂ"

msgid "New Folder"
msgstr "ਨਵਾਂ ਫੋਲਡਰ"

msgid "On the dock"
msgstr "ਡੌਕ ਉੱਤੇ"

msgid "Opaque"
msgstr "ਅਪਾਰਦਰਸ਼ੀ"

#, python-format
msgid "Open %s"
msgstr "%s ਖੋਲ੍ਹੋ"

msgid "Open folder background color"
msgstr "ਖੁੱਲ੍ਹੇ ਫੋਲਡਰ ਦੇ ਪਿਛੋਕੜ ਦਾ ਰੰਗ"

msgid "Open folder preview"
msgstr "ਖੁੱਲ੍ਹੇ ਫੋਲਡਰ ਦੀ ਝਲਕ"

msgid "Open folder transparency"
msgstr "ਖੁੱਲ੍ਹੇ ਫੋਲਡਰ ਦੀ ਪਾਰਦਰਸ਼ਤਾ"

msgid "Opening and closing animation"
msgstr "ਖੋਲ੍ਹਣ ਅਤੇ ਬੰਦ ਕਰਨ ਦੀ ਐਨੀਮੇਸ਼ਨ"

msgid "Remove wallpaper"
msgstr "ਵਾਲਪੇਪਰ ਹਟਾਓ"

msgid "Replace…"
msgstr "ਬਦਲੋ…"

msgid "Scale"
msgstr "ਆਕਾਰ ਬਦਲਾਅ"

msgid "Settings → Ubuntu Desktop → Dock → Dock folders"
msgstr "ਸੈਟਿੰਗਾਂ → Ubuntu ਡੈਸਕਟਾਪ → ਡੌਕ → ਡੌਕ ਫੋਲਡਰ"

msgid "Transparency"
msgstr "ਪਾਰਦਰਸ਼ਤਾ"

msgid "Transparent"
msgstr "ਪਾਰਦਰਸ਼ੀ"

msgid "Wallpaper"
msgstr "ਵਾਲਪੇਪਰ"

msgid "When opened"
msgstr "ਖੁੱਲ੍ਹਣ ਵੇਲੇ"

msgid "App-grid folders"
msgstr "ਐਪ ਗਰਿੱਡ ਦੇ ਫੋਲਡਰ"

msgid "Add an app-grid folder"
msgstr "ਐਪ ਗਰਿੱਡ ਤੋਂ ਫੋਲਡਰ ਜੋੜੋ"

msgid "Keep folder names and applications in sync with GNOME's app grid"
msgstr "ਫੋਲਡਰ ਦੇ ਨਾਮ ਅਤੇ ਐਪ ਨੂੰ GNOME ਐਪ ਗਰਿੱਡ ਨਾਲ ਸਿੰਕ ਰੱਖੋ"

msgid "Pin to dock"
msgstr "ਡੌਕ ਉੱਤੇ ਪਿੰਨ ਕਰੋ"

msgid "Pinned"
msgstr "ਪਿੰਨ ਕੀਤਾ"

msgid "No app-grid folders"
msgstr "ਐਪ ਗਰਿੱਡ ਵਿੱਚ ਕੋਈ ਫੋਲਡਰ ਨਹੀਂ"

msgid "Create a folder in Show Apps first"
msgstr "ਪਹਿਲਾਂ «ਐਪ ਦਿਖਾਓ» ਵਿੱਚ ਫੋਲਡਰ ਬਣਾਓ"

msgid "Folder updated"
msgstr "ਫੋਲਡਰ ਅੱਪਡੇਟ ਹੋਇਆ"

msgid "Undo"
msgstr "ਵਾਪਸ ਕਰੋ"

msgid "Undo last move"
msgstr "ਆਖਰੀ ਹਿਲਾਉਣਾ ਵਾਪਸ ਕਰੋ"

msgid "Open windows"
msgstr "ਖੁੱਲ੍ਹੀਆਂ ਵਿੰਡੋਜ਼"

#, python-format
msgid "Could not open %s"
msgstr "%s ਖੋਲ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ"
