#, python-format
msgid "%s, percent"
msgstr "%s, yüzde"

msgid "All files"
msgstr "Tüm dosyalar"

msgid "All images — PNG, JPEG, BMP, WebP, GIF, SVG"
msgstr "Tüm görüntüler — PNG, JPEG, BMP, WebP, GIF, SVG"

msgid "Appearance and animation"
msgstr "Görünüm ve animasyon"

msgid "Application folders, appearance, and animation"
msgstr "Uygulama klasörleri, görünüm ve animasyon"

msgid "Application launcher not found."
msgstr "Uygulama başlatıcısı bulunamadı."

msgid "Applications in a folder share one icon and a running indicator"
msgstr "Klasördeki uygulamalar tek bir simgeyi ve çalışma göstergesini paylaşır"

msgid "Background color"
msgstr "Arka plan rengi"

msgid "Blurs the desktop and windows behind a folder and adds a translucent tint. Icons stay sharp. May increase GPU usage."
msgstr "Klasörün arkasındaki masaüstünü ve pencereleri bulanıklaştırır ve yarı saydam bir renk tonu ekler. Simgeler net kalır. GPU kullanımını artırabilir."

msgid "Change names, labels, colors, and wallpaper using the gear inside a folder"
msgstr "Klasördeki dişli simgesinden adları, etiketleri, renkleri ve duvar kâğıdını değiştirin"

msgid "Changes are saved automatically"
msgstr "Değişiklikler otomatik kaydedilir"

msgid "Choose an application"
msgstr "Uygulama seçin"

msgid "Choose…"
msgstr "Seç…"

msgid "Close"
msgstr "Kapat"

msgid "Could not launch the application."
msgstr "Uygulama başlatılamadı."

msgid "Could not open system settings"
msgstr "Sistem ayarları açılamadı"

msgid "Could not open the application"
msgstr "Uygulama açılamadı"

msgid "Could not open the image"
msgstr "Görüntü açılamadı"

msgid "Customize each folder"
