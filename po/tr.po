msgstr "Klasör ayarları"

msgid "Folder wallpaper"
msgstr "Klasör duvar kâğıdı"

msgid "Folders on the dock"
msgstr "Dock üzerindeki klasörler"

msgid "Font size below dock icons, in pixels"
msgstr "Dock simgelerinin altındaki yazı tipi boyutu, piksel olarak"

msgid "General folder settings"
msgstr "Genel klasör ayarları"

msgid "Genie effect"
msgstr "Cin efekti"

msgid "Glass tint transparency"
msgstr "Cam renk tonu saydamlığı"

