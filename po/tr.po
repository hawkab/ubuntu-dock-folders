msgstr "Açık klasör ön izlemesi"

msgid "Open folder transparency"
msgstr "Açık klasör saydamlığı"

msgid "Opening and closing animation"
msgstr "Açılış ve kapanış animasyonu"

msgid "Remove wallpaper"
msgstr "Duvar kâğıdını kaldır"

msgid "Replace…"
msgstr "Değiştir…"

msgid "Scale"
msgstr "Ölçekleme"

msgid "Settings → Ubuntu Desktop → Dock → Dock folders"
