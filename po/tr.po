msgstr "Dock klasörleri"

msgid "Dock icon background color"
msgstr "Dock simgesi arka plan rengi"

msgid "Dock icon preview"
msgstr "Dock simgesi ön izlemesi"

msgid "Dock icon transparency"
msgstr "Dock simgesi saydamlığı"

