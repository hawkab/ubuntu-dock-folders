msgid "Material Glass: blurred background, translucent tint, and sharp icons."
msgstr "Material Glass: bulanık arka plan, yarı saydam renk tonu ve net simgeler."

msgid "Name"
msgstr "Ad"

msgid "New Folder"
msgstr "Yeni klasör"

msgid "On the dock"
msgstr "Dock üzerinde"

msgid "Opaque"
msgstr "Opak"

