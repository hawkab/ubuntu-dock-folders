msgstr "%s ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"

msgid "Folder icon size"
msgstr "ಫೋಲ್ಡರ್ ಐಕಾನ್ ಗಾತ್ರ"


msgid "No animation"
msgstr "ಅನಿಮೇಷನ್ ಇಲ್ಲ"

msgid "Magic Lamp"
msgstr "ಮಾಯಾ ದೀಪ"

msgid "Fold"
msgstr "ಮಡಚುವುದು"


msgid "Animation speed"
msgstr "ಅನಿಮೇಷನ್ ವೇಗ"

msgid "Mini-icon size"
msgstr "ಚಿಕ್ಕ ಐಕಾನ್‌ಗಳ ಗಾತ್ರ"

