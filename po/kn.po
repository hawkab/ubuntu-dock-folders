msgstr "ಹೆಸರು"

msgid "New Folder"
msgstr "ಹೊಸ ಫೋಲ್ಡರ್"

msgid "On the dock"
msgstr "ಡಾಕ್‌ನಲ್ಲಿ"

msgid "Opaque"
msgstr "ಅಪಾರದರ್ಶಕ"

