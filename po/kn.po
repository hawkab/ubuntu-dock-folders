#, python-format
msgid "%s, percent"
msgstr "%s, ಶೇಕಡಾ"

msgid "All files"
msgstr "ಎಲ್ಲ ಕಡತಗಳು"

msgid "All images — PNG, JPEG, BMP, WebP, GIF, SVG"
msgstr "ಎಲ್ಲ ಚಿತ್ರಗಳು — PNG, JPEG, BMP, WebP, GIF, SVG"

msgid "Appearance and animation"
msgstr "ನೋಟ ಮತ್ತು ಅನಿಮೇಶನ್"

msgid "Application folders, appearance, and animation"
msgstr "ಅನ್ವಯಗಳ ಫೋಲ್ಡರ್‌ಗಳು, ನೋಟ ಮತ್ತು ಅನಿಮೇಶನ್"

msgid "Application launcher not found."
msgstr "ಅನ್ವಯದ ಲಾಂಚರ್ ಕಂಡುಬಂದಿಲ್ಲ."

msgid "Applications in a folder share one icon and a running indicator"
msgstr "ಫೋಲ್ಡರ್‌ನ ಅನ್ವಯಗಳು ಒಂದೇ ಚಿಹ್ನೆ ಮತ್ತು ಚಾಲನೆಯ ಸೂಚಕವನ್ನು ಹಂಚಿಕೊಳ್ಳುತ್ತವೆ"

msgid "Background color"
msgstr "ಹಿನ್ನೆಲೆ ಬಣ್ಣ"

msgid "Blurs the desktop and windows behind a folder and adds a translucent tint. Icons stay sharp. May increase GPU usage."
msgstr "ಫೋಲ್ಡರ್ ಹಿಂದಿನ ಡೆಸ್ಕ್‌ಟಾಪ್ ಮತ್ತು ಕಿಟಕಿಗಳನ್ನು ಮಸುಕಾಗಿಸಿ ಅರೆಪಾರದರ್ಶಕ ಬಣ್ಣವನ್ನು ಸೇರಿಸುತ್ತದೆ. ಚಿಹ್ನೆಗಳು ಸ್ಪಷ್ಟವಾಗಿರುತ್ತವೆ. GPU ಬಳಕೆ ಹೆಚ್ಚಾಗಬಹುದು."

msgid "Change names, labels, colors, and wallpaper using the gear inside a folder"
msgstr "ಫೋಲ್ಡರ್ ಒಳಗಿನ ಗೇರ್ ಮೂಲಕ ಹೆಸರುಗಳು, ಲೇಬಲ್‌ಗಳು, ಬಣ್ಣಗಳು ಮತ್ತು ವಾಲ್‌ಪೇಪರ್ ಬದಲಾಯಿಸಿ"

msgid "Changes are saved automatically"
msgstr "ಬದಲಾವಣೆಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಉಳಿಯುತ್ತವೆ"

msgid "Choose an application"
msgstr "ಅನ್ವಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ"

msgid "Choose…"
msgstr "ಆಯ್ಕೆಮಾಡಿ…"

msgid "Close"
msgstr "ಮುಚ್ಚಿ"

msgid "Could not launch the application."
msgstr "ಅನ್ವಯವನ್ನು ಆರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

msgid "Could not open system settings"
msgstr "ವ್ಯವಸ್ಥೆಯ ಸಿದ್ಧತೆಗಳನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"

msgid "Could not open the application"
msgstr "ಅನ್ವಯವನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"

msgid "Could not open the image"
msgstr "ಚಿತ್ರವನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"

msgid "Customize each folder"
msgstr "ಪ್ರತಿ ಫೋಲ್ಡರ್ ಅನ್ನು ಹೊಂದಿಸಿ"

msgid "Dock folders"
msgstr "ಡಾಕ್ ಫೋಲ್ಡರ್‌ಗಳು"

msgid "Dock icon background color"
msgstr "ಡಾಕ್ ಚಿಹ್ನೆಯ ಹಿನ್ನೆಲೆ ಬಣ್ಣ"

msgid "Dock icon preview"
msgstr "ಡಾಕ್ ಚಿಹ್ನೆಯ ಮುನ್ನೋಟ"

msgid "Dock icon transparency"
msgstr "ಡಾಕ್ ಚಿಹ್ನೆಯ ಪಾರದರ್ಶಕತೆ"

msgid "Drag an icon onto another to create a folder. Reorder applications inside a folder, or drag them out to move them back to the dock."
msgstr "ಫೋಲ್ಡರ್ ರಚಿಸಲು ಒಂದು ಚಿಹ್ನೆಯನ್ನು ಮತ್ತೊಂದರ ಮೇಲೆ ಎಳೆಯಿರಿ. ಫೋಲ್ಡರ್‌ನ ಅನ್ವಯಗಳ ಕ್ರಮ ಬದಲಾಯಿಸಿ ಅಥವಾ ಅವುಗಳನ್ನು ಹೊರಗೆ ಎಳೆದು ಡಾಕ್‌ಗೆ ಮರಳಿಸಿ."

msgid "Folder appearance"
msgstr "ಫೋಲ್ಡರ್ ನೋಟ"

msgid "Folder label size"
msgstr "ಫೋಲ್ಡರ್ ಲೇಬಲ್ ಗಾತ್ರ"

msgid "Folder not found."
msgstr "ಫೋಲ್ಡರ್ ಕಂಡುಬಂದಿಲ್ಲ."

msgid "Folder settings"
msgstr "ಫೋಲ್ಡರ್ ಸಿದ್ಧತೆಗಳು"

msgid "Folder wallpaper"
msgstr "ಫೋಲ್ಡರ್ ವಾಲ್‌ಪೇಪರ್"

msgid "Folders on the dock"
msgstr "ಡಾಕ್‌ನಲ್ಲಿರುವ ಫೋಲ್ಡರ್‌ಗಳು"

msgid "Font size below dock icons, in pixels"
msgstr "ಡಾಕ್ ಚಿಹ್ನೆಗಳ ಕೆಳಗಿನ ಅಕ್ಷರಶೈಲಿ ಗಾತ್ರ, ಪಿಕ್ಸೆಲ್‌ಗಳಲ್ಲಿ"

msgid "General folder settings"
msgstr "ಫೋಲ್ಡರ್‌ಗಳ ಸಾಮಾನ್ಯ ಸಿದ್ಧತೆಗಳು"

msgid "Genie effect"
msgstr "ಜಿನಿ ಪರಿಣಾಮ"

msgid "Glass tint transparency"
msgstr "ಗಾಜಿನ ಬಣ್ಣದ ಪಾರದರ್ಶಕತೆ"

msgid "Icon preview"
msgstr "ಚಿಹ್ನೆಯ ಮುನ್ನೋಟ"

msgid "Image selected"
msgstr "ಚಿತ್ರವನ್ನು ಆಯ್ಕೆಮಾಡಲಾಗಿದೆ"

msgid "Label below the icon"
msgstr "ಚಿಹ್ನೆಯ ಕೆಳಗಿನ ಲೇಬಲ್"

msgid "Material Glass — frosted glass"
msgstr "Material Glass — ಮಸುಕು ಗಾಜು"

msgid "Material Glass: blurred background, translucent tint, and sharp icons."
msgstr "Material Glass: ಮಸುಕು ಹಿನ್ನೆಲೆ, ಅರೆಪಾರದರ್ಶಕ ಬಣ್ಣ ಮತ್ತು ಸ್ಪಷ್ಟ ಚಿಹ್ನೆಗಳು."

