msgstr "ಪಿನ್ ಮಾಡಲಾಗಿದೆ"

msgid "No app-grid folders"
msgstr "ಆ್ಯಪ್ ಗ್ರಿಡ್‌ನಲ್ಲಿ ಫೋಲ್ಡರ್‌ಗಳಿಲ್ಲ"

msgid "Create a folder in Show Apps first"
msgstr "ಮೊದಲು «ಆ್ಯಪ್‌ಗಳನ್ನು ತೋರಿಸಿ»ಯಲ್ಲಿ ಫೋಲ್ಡರ್ ರಚಿಸಿ"

