msgstr "Project-Id-Version: ubuntu-dock-folders 1.0.0\nReport-Msgid-Bugs-To: https://github.com/hawkab/ubuntu-dock-folders/issues\nPO-Revision-Date: 2026-10-10 12:00+0300\nLast-Translator: Ubuntu Dock Folders contributors\nLanguage-Team: uk\nLanguage: uk\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

#, python-format
msgid "%s, percent"
msgstr "%s, відсотків"

msgid "All files"
msgstr "Усі файли"

msgid "All images — PNG, JPEG, BMP, WebP, GIF, SVG"
msgstr "Усі зображення — PNG, JPEG, BMP, WebP, GIF, SVG"

msgid "Appearance and animation"
msgstr "Вигляд і анімація"

msgid "Application folders, appearance, and animation"
msgstr "Теки застосунків, вигляд і анімація"

msgid "Application launcher not found."
msgstr "Не знайдено засіб запуску застосунку."

msgid "Applications in a folder share one icon and a running indicator"
msgstr "Застосунки в теці мають спільну піктограму й індикатор роботи"

msgid "Background color"
msgstr "Колір тла"

msgid "Blurs the desktop and windows behind a folder and adds a translucent tint. Icons stay sharp. May increase GPU usage."
msgstr "Розмиває стільницю й вікна за текою та додає напівпрозорий відтінок. Піктограми залишаються чіткими. Може збільшити навантаження на GPU."

msgid "Change names, labels, colors, and wallpaper using the gear inside a folder"
msgstr "Змінюйте назви, підписи, кольори й шпалери за допомогою шестерні всередині теки"

msgid "Changes are saved automatically"
msgstr "Зміни зберігаються автоматично"

msgid "Choose an application"
msgstr "Виберіть застосунок"

msgid "Choose…"
msgstr "Вибрати…"

msgid "Close"
msgstr "Закрити"

msgid "Could not launch the application."
msgstr "Не вдалося запустити застосунок."

msgid "Could not open system settings"
msgstr "Не вдалося відкрити системні налаштування"

msgid "Could not open the application"
msgstr "Не вдалося відкрити застосунок"

msgid "Could not open the image"
msgstr "Не вдалося відкрити зображення"

msgid "Customize each folder"
msgstr "Налаштовувати кожну теку"

msgid "Dock folders"
msgstr "Теки на панелі"

msgid "Dock icon background color"
msgstr "Колір тла піктограми на панелі"

msgid "Dock icon preview"
msgstr "Перегляд піктограми на панелі"

msgid "Dock icon transparency"
msgstr "Прозорість піктограми на панелі"

msgid "Drag an icon onto another to create a folder. Reorder applications inside a folder, or drag them out to move them back to the dock."
msgstr "Перетягніть піктограму на іншу, щоб створити теку. Змінюйте порядок застосунків усередині теки або перетягуйте їх назовні, щоб повернути на панель."

msgid "Folder appearance"
msgstr "Вигляд теки"

msgid "Folder label size"
msgstr "Розмір підпису теки"

msgid "Folder not found."
msgstr "Теку не знайдено."

msgid "Folder settings"
msgstr "Налаштування теки"

msgid "Folder wallpaper"
msgstr "Шпалери теки"

msgid "Folders on the dock"
msgstr "Теки на панелі"

msgid "Font size below dock icons, in pixels"
msgstr "Розмір шрифту під піктограмами панелі, у пікселях"

msgid "General folder settings"
msgstr "Загальні налаштування тек"

msgid "Genie effect"
msgstr "Ефект джина"

msgid "Glass tint transparency"
msgstr "Прозорість відтінку скла"

msgid "Icon preview"
msgstr "Перегляд піктограми"

msgid "Image selected"
msgstr "Зображення вибрано"

msgid "Label below the icon"
msgstr "Підпис під піктограмою"

msgid "Material Glass — frosted glass"
msgstr "Material Glass — матове скло"

msgid "Material Glass: blurred background, translucent tint, and sharp icons."
msgstr "Material Glass: розмите тло, напівпрозорий відтінок і чіткі піктограми."

msgid "Name"
msgstr "Назва"

msgid "New Folder"
msgstr "Нова тека"

msgid "On the dock"
msgstr "На панелі"

msgid "Opaque"
msgstr "Непрозоре"

#, python-format
msgid "Open %s"
msgstr "Відкрити %s"

msgid "Open folder background color"
msgstr "Колір тла відкритої теки"

msgid "Open folder preview"
msgstr "Перегляд відкритої теки"

msgid "Open folder transparency"
msgstr "Прозорість відкритої теки"

msgid "Opening and closing animation"
msgstr "Анімація відкриття й закриття"

msgid "Remove wallpaper"
msgstr "Вилучити шпалери"

msgid "Replace…"
msgstr "Замінити…"

msgid "Scale"
msgstr "Масштабування"

msgid "Settings → Ubuntu Desktop → Dock → Dock folders"
msgstr "Налаштування → Стільниця Ubuntu → Панель → Теки на панелі"

msgid "Transparency"
msgstr "Прозорість"

msgid "Transparent"
msgstr "Прозоре"

msgid "Wallpaper"
msgstr "Шпалери"

msgid "When opened"
msgstr "Після відкриття"

msgid "App-grid folders"
msgstr "Теки сітки застосунків"

msgid "Add an app-grid folder"
msgstr "Додати теку із сітки застосунків"

msgid "Keep folder names and applications in sync with GNOME's app grid"
msgstr "Синхронізувати назви та застосунки із сіткою застосунків GNOME"

msgid "Pin to dock"
msgstr "Закріпити на панелі"

msgid "Pinned"
msgstr "Закріплено"

msgid "No app-grid folders"
msgstr "У сітці застосунків немає тек"

msgid "Create a folder in Show Apps first"
msgstr "Спочатку створіть теку в меню «Показати застосунки»"

msgid "Folder updated"
msgstr "Теку оновлено"

msgid "Undo"
msgstr "Скасувати"

msgid "Undo last move"
msgstr "Скасувати останнє переміщення"

msgid "Open windows"
msgstr "Відкриті вікна"

#, python-format
msgid "Could not open %s"
msgstr "Не вдалося відкрити %s"

msgid "Folder icon size"
msgstr "Розмір піктограми теки"


msgid "No animation"
msgstr "Без анімації"

msgid "Magic Lamp"
msgstr "Чарівна лампа"

msgid "Fold"
msgstr "Складання"


msgid "Animation speed"
msgstr "Швидкість анімації"

msgid "Mini-icon size"
msgstr "Розмір мініпіктограм"

msgid "Unfold from edge"
msgstr "Розгортання від краю"

msgid "Sheet"
msgstr "Аркуш (Sheet)"

msgid "Icon rotation"
msgstr "Поворот піктограм"

msgid "Always use card stack"
msgstr "Завжди використовувати стос карток"


msgid "Fade"
msgstr "Плавна поява"

msgid "On hover"
msgstr "При наведенні"

msgid "No effect"
msgstr "Без ефекту"

msgid "Rotate by 30°"
msgstr "Поворот на 30°"

msgid "Fan out cards"
msgstr "Розкриття карток"

msgid "Open folder icon size"
msgstr "Розмір піктограм у відкритій теці"

msgid "Rotate on hover"
msgstr "Поворот при наведенні"

msgid "Hover rotation angle"
msgstr "Кут повороту при наведенні"

msgid "Hover animation speed"
msgstr "Швидкість анімації при наведенні"

msgid "Rotate and fan out cards"
msgstr "Поворот і розкриття карток"

msgid "Background blur"
msgstr "Розмиття тла"

msgid "0% keeps the background sharp. Transparency is adjusted separately for each folder."
msgstr "0% — чітке тло. Прозорість налаштовується окремо для кожної теки."

msgid "Transparency affects the background color; blur is independent."
msgstr "Прозорість впливає на колір тла; розмиття налаштовується окремо."

msgid "Apply to all folders…"
msgstr "Застосувати до всіх тек…"

msgid "Replace other folders’ appearance?"
msgstr "Замінити вигляд решти тек?"

msgid "This will overwrite the custom appearance settings of all other folders. Names and applications will stay the same."
msgstr "Індивідуальні налаштування вигляду всіх інших тек буде замінено. Назви та склад застосунків збережуться."

msgid "Apply to all folders"
msgstr "Застосувати до всіх тек"

msgid "Cancel"
msgstr "Скасувати"

msgid "Existing folders"
msgstr "Наявні теки"

msgid "Choose saved groups or folders from GNOME's app grid"
msgstr "Виберіть збережені групи або теки із сітки програм GNOME"

msgid "No folders available"
msgstr "Немає доступних тек"

msgid "Pin to panel"
msgstr "Закріпити на панелі"

msgid "Unpin from panel"
msgstr "Відкріпити від панелі"

msgid "Allow customizing each folder separately"
msgstr "Дозволити налаштовувати оформлення кожної теки окремо"

msgid "Preview animation"
msgstr "Попередній перегляд анімації"

msgid "Continuous rotation speed"
msgstr "Швидкість постійного обертання"

msgid "Rotation speed on hover"
msgstr "Швидкість обертання при наведенні"

msgid "0 disables each mode. A nonzero hover speed replaces continuous speed while hovered. Negative speeds reverse rotation."
msgstr "0 вимикає відповідний режим. Під час наведення ненульова швидкість замінює швидкість постійного обертання. Від’ємна швидкість змінює напрямок обертання."
