msgstr "Segerakkan nama folder dan aplikasi dengan grid aplikasi GNOME"

msgid "Pin to dock"
msgstr "Semat pada dok"

msgid "Pinned"
msgstr "Disemat"

msgid "No app-grid folders"
msgstr "Tiada folder dalam grid aplikasi"

msgid "Create a folder in Show Apps first"
msgstr "Cipta folder dalam “Tunjukkan Aplikasi” dahulu"

msgid "Folder updated"
msgstr "Folder dikemas kini"

msgid "Undo"
msgstr "Buat asal"

msgid "Undo last move"
msgstr "Buat asal pemindahan terakhir"

msgid "Open windows"
msgstr "Tetingkap terbuka"

