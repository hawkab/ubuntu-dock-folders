msgstr "Folder dok"

msgid "Dock icon background color"
msgstr "Warna latar belakang ikon dok"

msgid "Dock icon preview"
msgstr "Pratonton ikon dok"

msgid "Dock icon transparency"
msgstr "Ketelusan ikon dok"

msgid "Drag an icon onto another to create a folder. Reorder applications inside a folder, or drag them out to move them back to the dock."
msgstr "Seret ikon ke atas ikon lain untuk mencipta folder. Susun semula aplikasi dalam folder atau seretnya keluar untuk mengembalikannya ke dok."

msgid "Folder appearance"
msgstr "Rupa folder"

msgid "Folder label size"
msgstr "Saiz label folder"

msgid "Folder not found."
msgstr "Folder tidak ditemui."

msgid "Folder settings"
msgstr "Tetapan folder"

msgid "Folder wallpaper"
msgstr "Kertas dinding folder"

msgid "Folders on the dock"
msgstr "Folder pada dok"

msgid "Font size below dock icons, in pixels"
msgstr "Saiz fon di bawah ikon dok, dalam piksel"

msgid "General folder settings"
msgstr "Tetapan folder umum"

msgid "Genie effect"
msgstr "Kesan jin"

msgid "Glass tint transparency"
msgstr "Ketelusan rona kaca"

msgid "Icon preview"
msgstr "Pratonton ikon"

msgid "Image selected"
msgstr "Imej dipilih"

msgid "Label below the icon"
msgstr "Label di bawah ikon"

msgid "Material Glass — frosted glass"
msgstr "Material Glass — kaca kabur"

msgid "Material Glass: blurred background, translucent tint, and sharp icons."
msgstr "Material Glass: latar belakang kabur, rona lut sinar dan ikon yang jelas."

msgid "Name"
msgstr "Nama"

msgid "New Folder"
msgstr "Folder baharu"

msgid "On the dock"
msgstr "Pada dok"

msgid "Opaque"
msgstr "Legap"

#, python-format
msgid "Open %s"
msgstr "Buka %s"

msgid "Open folder background color"
msgstr "Warna latar belakang folder terbuka"

msgid "Open folder preview"
msgstr "Pratonton folder terbuka"

msgid "Open folder transparency"
msgstr "Ketelusan folder terbuka"

msgid "Opening and closing animation"
msgstr "Animasi membuka dan menutup"

msgid "Remove wallpaper"
msgstr "Alih keluar kertas dinding"

msgid "Replace…"
msgstr "Ganti…"

msgid "Scale"
msgstr "Penskalaan"

msgid "Settings → Ubuntu Desktop → Dock → Dock folders"
msgstr "Tetapan → Desktop Ubuntu → Dok → Folder dok"

msgid "Transparency"
msgstr "Ketelusan"

msgid "Transparent"
msgstr "Telus"

msgid "Wallpaper"
msgstr "Kertas dinding"

