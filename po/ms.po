#, python-format
msgid "%s, percent"
msgstr "%s, peratus"

msgid "All files"
msgstr "Semua fail"

msgid "All images — PNG, JPEG, BMP, WebP, GIF, SVG"
msgstr "Semua imej — PNG, JPEG, BMP, WebP, GIF, SVG"

msgid "Appearance and animation"
msgstr "Rupa dan animasi"

msgid "Application folders, appearance, and animation"
msgstr "Folder aplikasi, rupa dan animasi"

msgid "Application launcher not found."
msgstr "Pelancar aplikasi tidak ditemui."

msgid "Applications in a folder share one icon and a running indicator"
msgstr "Aplikasi dalam folder berkongsi satu ikon dan penunjuk aplikasi berjalan"

msgid "Background color"
msgstr "Warna latar belakang"

msgid "Blurs the desktop and windows behind a folder and adds a translucent tint. Icons stay sharp. May increase GPU usage."
msgstr "Mengaburkan desktop dan tetingkap di belakang folder serta menambah rona lut sinar. Ikon kekal jelas. Mungkin meningkatkan penggunaan GPU."

msgid "Change names, labels, colors, and wallpaper using the gear inside a folder"
msgstr "Ubah nama, label, warna dan kertas dinding menggunakan ikon gear dalam folder"

msgid "Changes are saved automatically"
msgstr "Perubahan disimpan secara automatik"

msgid "Choose an application"
msgstr "Pilih aplikasi"

msgid "Choose…"
msgstr "Pilih…"

msgid "Close"
msgstr "Tutup"

msgid "Could not launch the application."
msgstr "Tidak dapat melancarkan aplikasi."

