#, python-format
msgid "%s, percent"
msgstr "%s, pour cent"

msgid "All files"
msgstr "Tous les fichiers"

msgid "All images — PNG, JPEG, BMP, WebP, GIF, SVG"
msgstr "Toutes les images — PNG, JPEG, BMP, WebP, GIF, SVG"

msgid "Appearance and animation"
msgstr "Apparence et animation"

msgid "Application folders, appearance, and animation"
msgstr "Dossiers d’applications, apparence et animation"

msgid "Application launcher not found."
msgstr "Lanceur d’application introuvable."

msgid "Applications in a folder share one icon and a running indicator"
msgstr "Les applications d’un dossier partagent une icône et un indicateur d’activité"

msgid "Background color"
msgstr "Couleur d’arrière-plan"

msgid "Blurs the desktop and windows behind a folder and adds a translucent tint. Icons stay sharp. May increase GPU usage."
msgstr "Floute le bureau et les fenêtres derrière le dossier et ajoute une teinte translucide. Les icônes restent nettes. Peut augmenter l’utilisation du GPU."

msgid "Change names, labels, colors, and wallpaper using the gear inside a folder"
msgstr "Modifiez les noms, les libellés, les couleurs et le fond d’écran avec l’engrenage dans le dossier"

msgid "Changes are saved automatically"
msgstr "Les modifications sont enregistrées automatiquement"

msgid "Choose an application"
msgstr "Choisir une application"

msgid "Choose…"
msgstr "Choisir…"

msgid "Close"
msgstr "Fermer"

msgid "Could not launch the application."
msgstr "Impossible de lancer l’application."

msgid "Could not open system settings"
msgstr "Impossible d’ouvrir les paramètres système"

msgid "Could not open the application"
msgstr "Impossible d’ouvrir l’application"

msgid "Could not open the image"
msgstr "Impossible d’ouvrir l’image"

msgid "Customize each folder"
msgstr "Personnaliser chaque dossier"

msgid "Dock folders"
msgstr "Dossiers du dock"

msgid "Dock icon background color"
msgstr "Couleur d’arrière-plan de l’icône du dock"

msgid "Dock icon preview"
msgstr "Aperçu de l’icône du dock"

msgid "Dock icon transparency"
msgstr "Transparence de l’icône du dock"

msgid "Drag an icon onto another to create a folder. Reorder applications inside a folder, or drag them out to move them back to the dock."
msgstr "Glissez une icône sur une autre pour créer un dossier. Réorganisez les applications dans le dossier ou faites-les glisser vers le dock pour les en retirer."

msgid "Folder appearance"
msgstr "Apparence du dossier"

msgid "Folder label size"
msgstr "Taille du libellé du dossier"

msgid "Folder not found."
msgstr "Dossier introuvable."

msgid "Folder settings"
msgstr "Paramètres du dossier"

msgid "Folder wallpaper"
msgstr "Fond d’écran du dossier"

msgid "Folders on the dock"
msgstr "Dossiers sur le dock"

msgid "Font size below dock icons, in pixels"
msgstr "Taille de police sous les icônes du dock, en pixels"

msgid "General folder settings"
msgstr "Paramètres généraux des dossiers"

msgid "Genie effect"
msgstr "Effet génie"

msgid "Glass tint transparency"
msgstr "Transparence de la teinte du verre"

msgid "Icon preview"
msgstr "Aperçu de l’icône"

msgid "Image selected"
msgstr "Image sélectionnée"

msgid "Label below the icon"
msgstr "Libellé sous l’icône"

msgid "Material Glass — frosted glass"
msgstr "Material Glass — verre dépoli"

msgid "Material Glass: blurred background, translucent tint, and sharp icons."
msgstr "Material Glass : arrière-plan flouté, teinte translucide et icônes nettes."

msgid "Name"
msgstr "Nom"

msgid "New Folder"
msgstr "Nouveau dossier"

msgid "On the dock"
msgstr "Sur le dock"

msgid "Opaque"
msgstr "Opaque"

#, python-format
msgid "Open %s"
msgstr "Ouvrir %s"

msgid "Open folder background color"
msgstr "Couleur d’arrière-plan du dossier ouvert"

msgid "Open folder preview"
msgstr "Aperçu du dossier ouvert"

msgid "Open folder transparency"
msgstr "Transparence du dossier ouvert"

msgid "Opening and closing animation"
msgstr "Animation d’ouverture et de fermeture"

msgid "Remove wallpaper"
msgstr "Supprimer le fond d’écran"

msgid "Replace…"
msgstr "Remplacer…"

msgid "Scale"
msgstr "Mise à l’échelle"

msgid "Settings → Ubuntu Desktop → Dock → Dock folders"
msgstr "Paramètres → Bureau Ubuntu → Dock → Dossiers du dock"

msgid "Transparency"
msgstr "Transparence"

msgid "Transparent"
msgstr "Transparent"

msgid "Wallpaper"
msgstr "Fond d’écran"

msgid "When opened"
msgstr "À l’ouverture"

msgid "App-grid folders"
msgstr "Dossiers de la grille d’applications"

msgid "Add an app-grid folder"
msgstr "Ajouter un dossier de la grille"

msgid "Keep folder names and applications in sync with GNOME's app grid"
msgstr "Synchroniser les noms et applications avec la grille de GNOME"

msgid "Pin to dock"
msgstr "Épingler au dock"

msgid "Pinned"
msgstr "Épinglé"

msgid "No app-grid folders"
msgstr "Aucun dossier dans la grille"

msgid "Create a folder in Show Apps first"
msgstr "Créez d’abord un dossier dans « Afficher les applications »"

msgid "Folder updated"
msgstr "Dossier mis à jour"

msgid "Undo"
msgstr "Annuler"

msgid "Undo last move"
msgstr "Annuler le dernier déplacement"

msgid "Open windows"
msgstr "Fenêtres ouvertes"

#, python-format
msgid "Could not open %s"
msgstr "Impossible d’ouvrir %s"

msgid "Folder icon size"
msgstr "Taille de l’icône du dossier"


msgid "No animation"
msgstr "Sans animation"

msgid "Magic Lamp"
msgstr "Lampe magique"

msgid "Fold"
msgstr "Pliage"


msgid "Animation speed"
msgstr "Vitesse d’animation"

msgid "Mini-icon size"
msgstr "Taille des mini-icônes"

msgid "Unfold from edge"
msgstr "Déplier depuis le bord"

msgid "Sheet"
msgstr "Feuille (Sheet)"

msgid "Icon rotation"
msgstr "Rotation des icônes"

msgid "Always use card stack"
msgstr "Toujours utiliser une pile de cartes"


msgid "Fade"
msgstr "Fondu"

msgid "On hover"
msgstr "Au survol"

msgid "No effect"
msgstr "Aucun effet"

msgid "Rotate by 30°"
msgstr "Tourner de 30°"

msgid "Fan out cards"
msgstr "Déployer les cartes"

msgid "Open folder icon size"
msgstr "Taille des icônes dans le dossier ouvert"

msgid "Rotate on hover"
msgstr "Pivoter au survol"

msgid "Hover rotation angle"
msgstr "Angle de rotation au survol"

msgid "Hover animation speed"
msgstr "Vitesse de l’animation au survol"

msgid "Rotate and fan out cards"
msgstr "Pivoter et déployer les cartes"

msgid "Background blur"
msgstr "Flou d’arrière-plan"

msgid "0% keeps the background sharp. Transparency is adjusted separately for each folder."
msgstr "À 0%, l’arrière-plan reste net. La transparence se règle séparément pour chaque dossier."

msgid "Transparency affects the background color; blur is independent."
msgstr "La transparence agit sur la couleur de fond ; le flou est indépendant."

msgid "Apply to all folders…"
msgstr "Appliquer à tous les dossiers…"

msgid "Replace other folders’ appearance?"
msgstr "Remplacer l’apparence des autres dossiers ?"

msgid "This will overwrite the custom appearance settings of all other folders. Names and applications will stay the same."
msgstr "Les réglages d’apparence personnalisés de tous les autres dossiers seront remplacés. Les noms et les applications resteront inchangés."

msgid "Apply to all folders"
msgstr "Appliquer à tous les dossiers"

msgid "Cancel"
msgstr "Annuler"

msgid "Existing folders"
msgstr "Dossiers existants"

msgid "Choose saved groups or folders from GNOME's app grid"
msgstr "Choisissez des groupes enregistrés ou des dossiers de la grille des applications GNOME"

msgid "No folders available"
msgstr "Aucun dossier disponible"

msgid "Pin to panel"
msgstr "Épingler au panneau"

msgid "Unpin from panel"
msgstr "Détacher du panneau"

msgid "Allow customizing each folder separately"
msgstr "Autoriser la personnalisation de chaque dossier séparément"

msgid "Preview animation"
msgstr "Aperçu de l’animation"

msgid "Continuous rotation speed"
msgstr "Vitesse de rotation continue"

msgid "Rotation speed on hover"
msgstr "Vitesse de rotation au survol"

msgid "0 disables each mode. A nonzero hover speed replaces continuous speed while hovered. Negative speeds reverse rotation."
msgstr "0 désactive chaque mode. Une vitesse non nulle au survol remplace la vitesse de rotation continue. Les vitesses négatives inversent le sens de rotation."
